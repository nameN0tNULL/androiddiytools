# Sakura Vision Bridge Phase B Session + Compact
BRIDGE_PORT=8090
BRIDGE_KEY="change-me"

TRANSLATE_URL="http://127.0.0.1:8080/v1/chat/completions"
LLAMA_TOKEN_COUNT_URL="http://127.0.0.1:8080/v1/chat/completions/input_tokens"
TRANSLATE_API_KEY=""
TRANSLATE_MODEL="Sakura-GalTransl-7B-v3.7"

TEMPERATURE=0.3
RETRY_TEMPERATURE=0.2
TOP_P=0.8
MAX_TOKENS=512
LLAMA_CACHE_PROMPT=true

LLAMA_CTX_SIZE=8192
OUTPUT_RESERVE_TOKENS=512
CONTEXT_SAFETY_TOKENS=512
COMPACT_TRIGGER_RATIO=0.72
COMPACT_HARD_RATIO=0.85
COMPACT_TARGET_TOKENS=2500
RECENT_HISTORY_ENTRIES=12
HARD_RECENT_HISTORY_ENTRIES=4

COMPACT_URL="http://127.0.0.1:8080/v1/chat/completions"
COMPACT_MODEL="Sakura-GalTransl-7B-v3.7"
COMPACT_TEMPERATURE=0.1
COMPACT_MAX_TOKENS=800

SESSION_PERSIST=true
SESSION_DIR="$HOME/Library/Application Support/SakuraVisionBridge/sessions"
PROMPT_VERSION="sakura-v3.7-mw-phase-b-session-001"

OCR_LANGUAGES="ja-JP"
OCR_LANGUAGE_CORRECTION=false
MAX_IMAGE_BYTES=12582912
STRIP_THINK_TAGS=true
